PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gpr_sicma
UPLOADS_DIR=./uploads

# URL du backend Spring Boot (appels serveur→serveur pour les sondages de satisfaction)
SPRING_BOOT_URL=http://localhost:8080

# Secret partagé avec Spring Boot (whatgpr.internal.secret / header X-WhatGPR-Secret).
# OBLIGATOIRE — générer une valeur aléatoire forte (ex: openssl rand -hex 32) et NE JAMAIS
# la committer. Doit être identique des deux côtés (Node et application.properties).
INTERNAL_SECRET=

# Délai (en heures) avant clôture automatique d'un sondage de satisfaction resté sans
# commentaire après un vote PARTIAL/UNSATISFIED.
SURVEY_STALE_HOURS=24

# Niveau de log Baileys (pino) : silent, error, warn, info, debug, trace
BAILEYS_LOG_LEVEL=silent
